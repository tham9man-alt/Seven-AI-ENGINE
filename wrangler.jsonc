
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seven-ai-engine",
  "main": "./worker.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sevenaiusers",
      "database_id": "ce4c7c11-c430-49b4-ba24-28ae262aaaa1"
    }
  ]
}
